# Face to Voice — environment variables
# Copy to web/.env.local for local development. Never commit real values.
# On Vercel add them as Sensitive environment variables.

# --- API keys (server-only; never exposed to the browser) ---
ANTHROPIC_API_KEY=
ELEVENLABS_API_KEY=

# --- Claude models ---
# Production casting route (fast, cheap). Pipeline slider naming runs offline.
CLAUDE_MODEL_PRODUCTION=claude-sonnet-5
CLAUDE_MODEL_PIPELINE=claude-opus-5-5

# --- Shared storage (Vercel Marketplace: Upstash Redis + Vercel Blob) ---
# Without these in development the app falls back to in-memory limits/caches.
# On any Vercel deployment (production or preview) the paid routes refuse to run without Redis (fail closed).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
BLOB_READ_WRITE_TOKEN=

# --- Abuse protection ---
# Random secret used to hash visitor IPs before they touch Redis or logs. Required on Vercel.
RATE_LIMIT_SALT=
# Bearer token for GET /api/usage (spend/cap dashboard). Leave empty to disable.
USAGE_ADMIN_TOKEN=

# --- Daily global caps (reset at 00:00 UTC) ---
# A design costs about 1 ElevenLabs credit per character of its preview line (100-180, typically ~125), speech ~0.05 per character.
# A casting (Claude reading the face) costs about 1.1 cents; a face already cast for this visitor is free.
DAILY_CAP_CASTINGS=200
DAILY_CAP_DESIGNS=20
DAILY_CAP_SAVES=10
DAILY_CAP_SPEAK_CHARS=20000

# --- Development ---
# 1 = don't call ElevenLabs at all: previews become short tones and no voice is created.
# Lets you work on the UI without a paid plan or credits. Never set this on Vercel.
FTV_MOCK_ELEVENLABS=
# 1 = don't call Claude: a fixed casting built from the face. With the line above, no key is needed at all.
FTV_MOCK_CLAUDE=
# Saved ElevenLabs voices kept in the LRU pool. Pool + 1 + studio voices must fit the plan's slots (Starter: 3 + 1 + 6 = 10).
VOICE_POOL_SIZE=3

# --- Fallback voices ---
# Comma-separated "presentation-age:voiceId" entries printed by web/scripts/studio-voices.ts
# (e.g. "feminine-70s:<voice id>"); the closest one is used when the daily save cap or the
# plan's voice quota is exhausted.
STUDIO_VOICE_IDS=
